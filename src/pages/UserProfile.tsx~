import UserProfileHeader from "../components/user profile/UserProfileHeader";
import UserProfileBody from "../components/user profile/UserProfileBody";
import UserProfileConnections from "../components/user profile/UserProfileConnections";
import { useGetBasicInfoQuery } from "../services/profileApi.ts";
import Navbar from "../components/home/Navbar.tsx";
import { useParams } from "react-router-dom";

function UserProfile({ profileType }: { profileType: "me" | "others" }) {
  const { userId } = useParams();
  const { data: basicInfoData } = useGetBasicInfoQuery({
    id: profileType === "others" ? userId : undefined,
  });

  return (
    <div>
      {basicInfoData && (
        <>
          {profileType==="me"&&<Navbar />}
          <UserProfileHeader basicInfo={basicInfoData.basicInfo} />
          <div className="flex">
            <UserProfileBody
              profileType={profileType}
              basicInfo={basicInfoData.basicInfo}
            />
            <UserProfileConnections basicInfo={basicInfoData.basicInfo} />
          </div>
        </>
      )}
    </div>
  );
}

export default UserProfile;
